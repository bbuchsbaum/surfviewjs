{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "tests/types/**/*.ts",
    "tests/types/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "examples",
    "tests/types/package"
  ]
}
