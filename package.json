{
  "name": "surfview",
  "version": "2.2.0",
  "description": "A modular Three.js-based brain surface visualization library",
  "type": "module",
  "main": "./dist/surfview.umd.cjs",
  "module": "./dist/surfview.es.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": [
    "./dist/surfview.es.js",
    "./dist/surfview.umd.cjs",
    "./dist/surfview.umd.js",
    "./dist/surfview.embed.iife.js",
    "./dist/surfview.report.es.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/surfview.es.js",
      "require": "./dist/surfview.umd.cjs"
    },
    "./react": {
      "types": "./dist/types/index.react.d.ts",
      "import": "./dist/surfview.react.es.js",
      "default": "./dist/surfview.react.es.js"
    },
    "./report": {
      "types": "./dist/types/index.report.d.ts",
      "import": "./dist/surfview.report.es.js",
      "default": "./dist/surfview.report.es.js"
    },
    "./controls": {
      "types": "./dist/types/controls-ui/index.d.ts",
      "import": "./dist/surfview.controls.es.js",
      "default": "./dist/surfview.controls.es.js"
    },
    "./controls/react": {
      "types": "./dist/types/controls-ui/react.d.ts",
      "import": "./dist/surfview.controls.react.es.js",
      "default": "./dist/surfview.controls.react.es.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "demo": "vite --config vite.demo.config.ts --open",
    "build": "npm run clean && vite build && vite build --config vite.config.embed.js && vite build --config vite.config.react.js && vite build --config vite.config.report.js && vite build --config vite.config.controls.js && vite build --config vite.config.controls-react.js && npm run build:types && npm run test:package-types && npm run check:controls-artifacts",
    "demo:build": "vite build --config vite.demo.config.ts",
    "build:types": "tsc --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "type-check:demo": "tsc -p tsconfig.demo.json",
    "test:types": "tsc -p tsconfig.contracts.json",
    "test:package-types": "tsc -p tests/types/package/tsconfig.json",
    "test:package-consumers": "node scripts/check-package-consumers.mjs",
    "test:docs-examples": "node scripts/check-documentation-examples.mjs",
    "audit:dependencies": "node scripts/check-dependency-audit.mjs",
    "test:react-fixture:build": "vite build --config tests/fixtures/react-controls/vite.config.ts",
    "check:controls-artifacts": "node scripts/check-controls-artifacts.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark:performance": "npm run build && node --expose-gc scripts/performance-benchmark.mjs",
    "benchmark:check": "node --expose-gc scripts/performance-benchmark.mjs --check",
    "benchmark:browser": "start-server-and-test dev:ci http://localhost:4173 \"playwright test tests/e2e/performance-benchmark.spec.ts\"",
    "playwright:test": "playwright test",
    "dev:ci": "vite dev --host 0.0.0.0 --port 4173",
    "test:playwright": "start-server-and-test dev:ci http://localhost:4173/tests/test-gifti.html playwright:test",
    "size": "size-limit",
    "prepublishOnly": "npm run build",
    "docs:api": "typedoc",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run test:docs-examples && npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "neuroscience",
    "brain",
    "visualization",
    "three.js",
    "neuroimaging",
    "fmri"
  ],
  "author": "Bradley Buchsbaum",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbuchsbaum/surfviewjs.git"
  },
  "bugs": {
    "url": "https://github.com/bbuchsbaum/surfviewjs/issues"
  },
  "homepage": "https://github.com/bbuchsbaum/surfviewjs#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@size-limit/file": "^13.0.3",
    "@types/colormap": "^2.3.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "lit": "3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^13.0.3",
    "start-server-and-test": "^3.0.12",
    "terser": "^5.51.2",
    "three": "0.185.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "colormap": "^2.3.2",
    "fflate": "^0.8.3"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "three": "^0.185.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "name": "ESM bundle",
      "path": "dist/surfview.es.js",
      "limit": "180 KB"
    },
    {
      "name": "Controls ESM bundle",
      "path": "dist/surfview.controls.es.js",
      "limit": "30 KB"
    },
    {
      "name": "Report ESM adapter",
      "path": "dist/surfview.report.es.js",
      "limit": "1 KB"
    },
    {
      "name": "Controls React ESM bundle",
      "path": "dist/surfview.controls.react.es.js",
      "limit": "3 KB"
    }
  ]
}
